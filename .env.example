# Browser-safe Supabase configuration. Use a separate project for each environment.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-local-anon-key

# Server-only values. Never prefix these with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=replace-with-local-service-role-key
ROFIES_ALLOWED_EMAIL_DOMAINS=iiitp.ac.in
ROFIES_APP_ORIGIN=http://localhost:3000
ROFIES_ENVIRONMENT=local
ROFIES_DEMO_MODE=true
ROFIES_MAINTENANCE_MODE=false
CRON_SECRET=replace-with-random-local-value

# Configure institution SMTP only in the Supabase Auth provider settings; never store SMTP
# credentials in this repository. Set the Supabase Site URL to ROFIES_APP_ORIGIN, allow
# /auth/confirm as a redirect, and use token-hash templates that send `type=email` for account
# confirmation and `type=recovery` for password recovery.
